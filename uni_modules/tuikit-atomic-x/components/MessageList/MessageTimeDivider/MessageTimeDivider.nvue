<template>
  <view class="msg-time-divider">
    <view class="msg-time-divider__content">
      <text class="msg-time-divider__text">{{ formattedTime }}</text>
    </view>
  </view>
</template>

<script>
import { formatTime } from '../../../utils/timeUtils'

export default {
  name: 'MessageTimeDivider',
  props: {
    timestamp: {
      type: Number,
      required: true
    }
  },
  computed: {
    formattedTime() {
      return formatTime(this.timestamp, true)
    }
  }
}
</script>

<style>
.msg-time-divider {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 10rpx 0;
  margin: 20rpx 0;
}

.msg-time-divider__content {
  margin: 0 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background-color: rgba(15, 18, 32, 0.05);
}

.msg-time-divider__text {
  font-size: 22rpx;
  font-weight: 600;
  color: #6A7182;
  line-height: 32rpx;
}
</style>
