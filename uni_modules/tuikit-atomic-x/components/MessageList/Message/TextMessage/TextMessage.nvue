<template>
  <view class="text-msg text-msg--no-select" :class="['text-msg__content', 'text-msg__content--'+ (message.isSentBySelf ? 'out' : 'in')]">
    <view class="text-msg__highlight">
      <view v-if="quoteMessage" class="text-msg__quote text-msg__quote--no-select" :class="'text-msg__quote--' + side" @tap="handleReferenceTap">
        <view class="text-msg__quote-header">
          <text class="text-msg__quote-sender text-msg__text--no-select" :class="'text-msg__quote-sender--' + side">{{ quoteMessage.msgSender || '' }}</text>
        </view>
        <view class="text-msg__quote-body">
          <text class="text-msg__quote-text text-msg__text--no-select" :class="'text-msg__quote-text--' + side">{{ quoteMessage.msgAbstract || '' }}</text>
        </view>
      </view>
      <view class="text-msg__body text-msg__body--no-select">
        <text v-if="!hasEmojiInText" class="text-msg__plain text-msg__text--no-select" :class="'text-msg__plain--' + side">{{ messageText }}</text>
        <view v-else class="text-msg__line">
          <template v-for="(seg, idx) in segments">
            <text v-if="seg.type === 'char'" :key="'c'+idx" class="text-msg__char text-msg__text--no-select" :class="'text-msg__plain--' + side">{{ seg.text }}</text>
            <image v-else :key="'e'+idx" class="text-msg__emoji" :src="seg.src" mode="aspectFit" resize="contain" />
          </template>
        </view>
        <view class="text-msg__touch-overlay"></view>
      </view>
    </view>
  </view>
</template>

<script>
import { parseTextToSegments, hasEmoji } from '../../../../utils/emojiUtils'

export default {
  name: 'TextMessage',
  props: {
    message: { type: Object, required: true }
  },
  computed: {
    side() { return this.message.isSentBySelf ? 'out' : 'in' },
    messageText() { return (this.message.messagePayload && this.message.messagePayload.text) || '' },
    hasEmojiInText() { return hasEmoji(this.messageText) },
    // 仅在含 emoji 时才走字符级切分，纯文本场景零开销
    segments() { return this.hasEmojiInText ? parseTextToSegments(this.messageText) : [] },
    quoteMessage() { return this.message.quoteMessageInfo }
  },
  methods: {
    handleReferenceTap() {
      if (this.quoteMessage && this.quoteMessage.msgID) {
        uni.$emit('scrollToMessage', this.quoteMessage.msgID)
      }
    }
  }
}
</script>

<style>
.text-msg { flex-direction: column; max-width: 500rpx; }
.text-msg--no-select { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.text-msg__content { flex: 1; }
.text-msg__content--in { background-color: #FFFFFF; border-width: 1rpx; border-style: solid; border-color: #ECEEF3; border-top-left-radius: 12rpx; border-top-right-radius: 36rpx; border-bottom-right-radius: 36rpx; border-bottom-left-radius: 36rpx; }
.text-msg__content--out { background-color: #4655F5; border-top-left-radius: 36rpx; border-top-right-radius: 12rpx; border-bottom-right-radius: 36rpx; border-bottom-left-radius: 36rpx; }
.text-msg__highlight { flex: 1; padding: 20rpx 28rpx; background-color: transparent; }
.text-msg__quote { background-color: #F3F4F8; border-left-width: 4rpx; border-left-color: #A3A9B7; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; }
.text-msg__quote--out { background-color: rgba(255, 255, 255, 0.16); border-left-color: rgba(255, 255, 255, 0.6); }
.text-msg__quote--no-select { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.text-msg__quote-header { margin-bottom: 8rpx; }
.text-msg__quote-sender { font-size: 24rpx; color: #3B4152; font-weight: 600; }
.text-msg__quote-sender--out { color: #FFFFFF; }
.text-msg__quote-body { max-width: 100%; }
.text-msg__quote-text { font-size: 26rpx; color: #545B6C; }
.text-msg__quote-text--out { color: #E4E7FF; }
.text-msg__text--no-select { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.text-msg__body { flex-direction: column; position: relative; }
.text-msg__body--no-select { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.text-msg__touch-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.text-msg__plain { font-size: 30rpx; line-height: 44rpx; color: #0F1220; word-wrap: break-word; word-break: break-all; white-space: normal; }
.text-msg__line { flex-direction: row; flex-wrap: wrap; align-items: center; }
.text-msg__char { font-size: 30rpx; line-height: 44rpx; color: #0F1220; }
.text-msg__plain--out { color: #FFFFFF; }
.text-msg__emoji { width: 40rpx; height: 40rpx; }
</style>
