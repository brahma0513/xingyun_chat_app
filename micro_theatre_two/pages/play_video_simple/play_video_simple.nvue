}
.pvs-cover-movie-arrow {
  font-size: 28rpx;
  color: #ffffff;
  margin-left: 8rpx;
}
.pvs-cover-black {
      background-color: rgba(0, 0, 0, 0.15);
  margin-top: 15rpx;
  margin-left: 30rpx;
  margin-right: 30rpx;
  
        border-radius: 16rpx;
}
.pvs-cover-info-row {
  flex-direction: row;
  align-items: center;
